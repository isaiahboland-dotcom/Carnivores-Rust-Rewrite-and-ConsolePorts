; c2rs vertex shader for untextured, coloured geometry: particles, blood,
; and the 2D overlays.
;   v0: position
;   v1: colour, 4 unsigned bytes (RGBA, 0..255)

.fvec projection[4], modelView[4]

.entry flat

.constf consts(1.0, 0.0, 0.00392156862, 0.0)

.out outpos position
.out outclr color

.alias inpos v0
.alias inclr v1

.proc flat
	mov r0.xyz, inpos
	mov r0.w, consts.x

	dp4 r1.x, modelView[0], r0
	dp4 r1.y, modelView[1], r0
	dp4 r1.z, modelView[2], r0
	dp4 r1.w, modelView[3], r0

	dp4 outpos.x, projection[0], r1
	dp4 outpos.y, projection[1], r1
	dp4 outpos.z, projection[2], r1
	dp4 outpos.w, projection[3], r1

	mul outclr, consts.zzzz, inclr
	end
.end
